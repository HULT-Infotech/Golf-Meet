{
  "name": "golf-meet-app",
  "version": "4.0.0",
  "description": "Golf Meet Application",
  "main": "index.js",
  "scripts": {
    "build": "npm run install:frontend && npm run build:frontend && npm run copy:dist",
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "ci:all": "npm install && npm --prefix frontend install && npm --prefix backend install",
    "build:frontend": "npm --prefix frontend run build",
    "copy:dist": "mkdir -p dist && cp -r frontend/dist/* ./dist/",
    "clean": "rm -rf dist",
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "start:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend run dev",
    "start:prod": "npm --prefix backend start",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "golf",
    "tournament",
    "react",
    "vite"
  ],
  "author": "HULT Infotech",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18.17.1",
    "npm": ">=9.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HULT-Infotech/Golf-Meet.git"
  }
}