{
  "name": "golf-meet-app",
  "version": "4.0.0",
  "description": "Full-stack React application",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:host": "concurrently \"npm run dev:frontend:host\" \"npm run dev:backend\"",
    "start:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:frontend:host": "npm --prefix frontend run dev -- --host",
    "dev:backend": "npm --prefix backend run dev",
    "ci:all": "npm ci --prefix frontend && npm ci --prefix backend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "build": "npm run install:frontend && npm run build:frontend",
    "install:frontend": "npm install --prefix frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "echo \"No backend build step needed\"",
    "clean": "rm -rf frontend/node_modules backend/node_modules node_modules"
  },
  "author": "HULT corp",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.10"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.0",
    "razorpay": "^2.9.6"
  }
}