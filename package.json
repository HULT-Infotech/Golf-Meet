{
  "name": "golf-meet-app",
  "version": "4.0.0",
  "description": "Full-stack React application",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:host": "concurrently \"npm run dev:frontend:host\" \"npm run dev:backend\"",
    "start:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:frontend:host": "npm --prefix frontend run dev -- --host",
    "dev:backend": "npm --prefix backend run dev",
    "ci:all": "npm ci --prefix frontend && npm ci --prefix backend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "echo \"No backend build step needed\"",
    "clean": "rm -rf frontend/node_modules backend/node_modules node_modules"
  },
  "author": "HULT corp",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}